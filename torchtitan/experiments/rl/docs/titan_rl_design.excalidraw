   "id": "el57",
   "type": "text",
   "x": 76,
   "y": 806,
   "width": 1272,
   "height": 19,
   "text": "Dataset -> _data_input_loop -> _rollout_loop (generate G answers + score) -> _batcher_loop (pack groups) -> _trainer_loop (GRPO update) -> push/pull weights -> generator.",
   "rawText": "Dataset -> _data_input_loop -> _rollout_loop (generate G answers + score) -> _batcher_loop (pack groups) -> _trainer_loop (GRPO update) -> push/pull weights -> generator.",
   "originalText": "Dataset -> _data_input_loop -> _rollout_loop (generate G answers + score) -> _batcher_loop (pack groups) -> _trainer_loop (GRPO update) -> push/pull weights -> generator.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "seed": 1791,
   "version": 1,
   "versionNonce": 1798,
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 10
  },
  {
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
