   "isDeleted": false,
   "id": "el58",
   "type": "text",
   "x": 76,
   "y": 828,
   "width": 1250,
   "height": 19,
   "text": "GRPO math: sample a GROUP of G answers; advantage = reward - group mean; loss = -min(ratio*A, clip(ratio,1+-eps)*A);  ratio = exp(trainer_logprob - generator_logprob).",
   "rawText": "GRPO math: sample a GROUP of G answers; advantage = reward - group mean; loss = -min(ratio*A, clip(ratio,1+-eps)*A);  ratio = exp(trainer_logprob - generator_logprob).",
   "originalText": "GRPO math: sample a GROUP of G answers; advantage = reward - group mean; loss = -min(ratio*A, clip(ratio,1+-eps)*A);  ratio = exp(trainer_logprob - generator_logprob).",
